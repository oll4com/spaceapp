{
  "name": "@space/api",
  "version": "0.2.5",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "scripts": {
    "dev": "SPACE_DEV_LOGIN=true SPACE_SESSION_SECRET=dev-only-change-me tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build:vault-broker": "esbuild src/vault-broker-main.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/space-vault-broker.mjs",
    "build": "tsc -p tsconfig.json && cp src/databases/sqlite-worker.py dist/databases/sqlite-worker.py && chmod +x dist/databases/sqlite-worker.py",
    "check": "tsc -p tsconfig.json --noEmit",
    "config:reference": "tsx src/config-reference.ts",
    "test": "vitest run --maxWorkers=2"
  },
  "dependencies": {
    "@ai-sdk/gateway": "4.0.87",
    "@fastify/compress": "^9.1.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/websocket": "^11.2.0",
    "@space/browser-host": "0.2.5",
    "@space/cli-host": "0.2.5",
    "@space/codex-app-server": "0.2.5",
    "@space/contracts": "0.2.5",
    "@space/db": "0.2.5",
    "@space/gateway": "0.2.5",
    "@space/memory-graph": "0.2.5",
    "@space/opencode-control": "0.2.5",
    "@space/runtime": "0.2.5",
    "@space/streaming": "0.2.5",
    "@t3-oss/env-core": "^0.13.11",
    "@temporalio/client": "1.24.0",
    "@xmldom/xmldom": "^0.8.15",
    "@xterm/headless": "^5.5.0",
    "fastify": "5.12.7",
    "imapflow": "^1.6.6",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "mysql2": "^3.24.5",
    "nanoid": "^5.1.6",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "6.3.289",
    "sanitize-html": "^2.18.1",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.1",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "license": "MIT"
}
