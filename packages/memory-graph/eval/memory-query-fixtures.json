    { "id": "memory:room-agent", "title": "Persistent Room Agent sessions", "body": "Room agents preserve durable goals and resume the active plan after a reconnect.", "provenance": "space-room-runtime", "createdAt": "2026-07-13T08:30:00.000Z" },
    { "id": "memory:canonical-plane", "title": "Canonical Gemini memory plane", "body": "The monthly Gemini history and its index remain the only canonical memory sources.", "provenance": "memory-policy", "createdAt": "2026-07-13T08:29:00.000Z" },
    { "id": "memory:athens-timer", "title": "Athens daily audit schedule", "body": "The deterministic memory audit starts at 03:30 Athens time with bounded jitter.", "provenance": "memory-maintenance", "createdAt": "2026-07-13T08:28:00.000Z" },
    { "id": "memory:mutation-journal", "title": "Crash-safe mutation journal", "body": "Canonical edits use hash guards, fsync, atomic rename and a reversible mutation journal.", "provenance": "memory-mutation-worker", "createdAt": "2026-07-13T08:27:00.000Z" },
    { "id": "memory:redaction", "title": "Memory transport redaction", "body": "Secret-like values are removed from node details, issue evidence and change-set list responses.", "provenance": "security-boundary", "createdAt": "2026-07-13T08:26:00.000Z" },
    { "id": "memory:cache-link", "title": "Canonical cache linkage", "body": "Exact title and body matches link cache rows to canonical record identifiers.", "provenance": "memory-cache-backfill", "createdAt": "2026-07-13T08:25:00.000Z" },
    { "id": "memory:graph-layout", "title": "Deterministic graph positions", "body": "The server precomputes clustered and relation positions so browsers never calculate graph layout.", "provenance": "memory-graph-engine", "createdAt": "2026-07-13T08:24:00.000Z" },
    { "id": "memory:mobile-list", "title": "Accessible mobile memory list", "body": "Mobile renders a searchable keyboard-accessible list and does not mount a WebGL canvas.", "provenance": "memory-workspace-ui", "createdAt": "2026-07-13T08:23:00.000Z" },
    { "id": "memory:issue-overlay", "title": "Durable issue status overlays", "body": "Operators resolve or ignore findings with a reason and optimistic state version.", "provenance": "memory-issue-api", "createdAt": "2026-07-13T08:22:00.000Z" },
    { "id": "memory:idempotency", "title": "Retry-safe command identities", "body": "Create, execute, reconcile and rollback commands require stable idempotency keys.", "provenance": "memory-command-api", "createdAt": "2026-07-13T08:21:00.000Z" },
    { "id": "memory:ai-audit", "title": "Fail-closed AI audit lane", "body": "AI receives bounded redacted batches without tools and cannot write canonical files directly.", "provenance": "memory-ai-validator", "createdAt": "2026-07-13T08:20:00.000Z" },
    { "id": "memory:repair", "title": "Validator-approved deterministic repair", "body": "Only lossless exact operations pass deterministic validation before automatic repair.", "provenance": "memory-consolidation", "createdAt": "2026-07-13T08:19:00.000Z" },
    { "id": "memory:rollback", "title": "Dedicated audited rollback", "body": "Rollback creates a linked reverse change set and preserves the original audit chain.", "provenance": "memory-change-api", "createdAt": "2026-07-13T08:18:00.000Z" },
    { "id": "memory:startup", "title": "Room startup isolation", "body": "Ordinary room loading and chat turn enqueue do not import graph code or read canonical files.", "provenance": "space-api-startup", "createdAt": "2026-07-13T08:17:00.000Z" },
    { "id": "memory:rollout", "title": "Guarded memory rollout", "body": "Graph, maintenance, mutations and AI repair use independent fail-closed feature gates.", "provenance": "memory-operations", "createdAt": "2026-07-13T08:16:00.000Z" }
